# Copy to `.env` for local testing (`npm run dev` or `npm start`).
# On GoDaddy, set these as private environment variables in the hosting panel.
# Never prefix SMTP secrets with VITE_ — they must stay server-side only.
#
# Local tip: `npm run dev` already serves `/api/contact` (no second terminal).
# Production/local prod mode: `npm run build` then `npm start`.
#
# GoDaddy cPanel mailbox (recommended for this project):
#   SMTP_HOST=<your-cpanel-host>.prod.phx3.secureserver.net
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@panoramiaccs.com
#   SMTP_PASSWORD=<mailbox password>
#
# If outbound SMTP is blocked on managed Node, try local relay instead:
#   SMTP_HOST=localhost
#   SMTP_PORT=25
#   SMTP_SECURE=false
#   (SMTP_USER / SMTP_PASSWORD can be empty for localhost relay)
#
# Optional diagnostics (disable after debugging):
#   CONTACT_DEBUG=true
#   then GET /api/contact/health

PORT=3000

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@panoramiaccs.com
SMTP_PASSWORD=
SMTP_FROM=contact@panoramiaccs.com

CONTACT_EMAIL=contact@panoramiaccs.com
CONTACT_DEBUG=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
