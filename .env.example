# Copy to `.env` for local testing (`npm run dev` or `npm start`).
# On GoDaddy Node.js Hosting, set private env vars in the hosting panel.
# Never prefix secrets with VITE_.
#
# IMPORTANT — GoDaddy Node.js Hosting blocks outbound SMTP.
# Production must use the platform email gateway (loopback HTTP):
#   EMAIL_DRIVER=godaddy   (or leave EMAIL_DRIVER=auto)
#   CONTACT_EMAIL=contact@panoramiaccs.com
# No SMTP_HOST/PASSWORD needed on GoDaddy Node for sending.
#
# Local development still uses real SMTP (works from your PC):
#   EMAIL_DRIVER=smtp
#   SMTP_HOST=<cpanel-host>.prod.phx3.secureserver.net
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@panoramiaccs.com
#   SMTP_PASSWORD=...
#
# Optional diagnostics:
#   CONTACT_DEBUG=true
#   GET /api/contact/health

PORT=3000

EMAIL_DRIVER=auto
CONTACT_EMAIL=contact@panoramiaccs.com

# Local SMTP only (ignored by GoDaddy gateway path)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@panoramiaccs.com
SMTP_PASSWORD=
SMTP_FROM=contact@panoramiaccs.com
CONTACT_DEBUG=false
