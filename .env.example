# Copy to `.env` for local testing (`npm run dev` or `npm start`).
# On GoDaddy, set these as private environment variables in the hosting panel.
# Never prefix SMTP secrets with VITE_ — they must stay server-side only.
#
# Local tip: `npm run dev` already serves `/api/contact` (no second terminal).
# Production/local prod mode: `npm run build` then `npm start`.

PORT=3000

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@panoramiaccs.com
SMTP_PASSWORD=

CONTACT_EMAIL=contact@panoramiaccs.com
